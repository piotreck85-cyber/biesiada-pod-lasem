# Existing backend environment — supply real values only in hosting secrets.
MONGO_URL=
DB_NAME=
JWT_SECRET=

# TimeTree: server-side only, never EXPO_PUBLIC_*.
TIMETREE_EMAIL=
TIMETREE_PASSWORD=
TIMETREE_CALENDAR_ID=
# Workspace owner ID, displayed in Settings → Integrations → TimeTree.
TIMETREE_OWNER_ID=
# true: existing backend scheduler; false: use the standalone worker instead.
TIMETREE_SCHEDULER_ENABLED=true

# true: queue manual requests for a separate worker (no exporter in the web process).
TIMETREE_USE_WORKER=false
